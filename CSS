:root{
  --bg:#0a0f0a;--card:#131a13;--border:#1e2e1e;
  --green:#22ff66;--green2:#00cc44;
  --text:#e8ffe8;--muted:#7aa07a
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Tajawal',sans-serif;background:var(--bg);color:var(--text)}
.mono{font-family:'JetBrains Mono',monospace}

header{
  position:sticky;top:0;z-index:100;
  background:rgba(10,15,10,.9);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
  padding:14px 24px;display:flex;justify-content:space-between;align-items:center
}
.logo{font-weight:900;font-size:22px;display:flex;gap:10px;align-items:center}
.logo b{color:var(--green)}
.badge{background:var(--green);color:#000;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:900}
.btn{padding:10px 18px;border-radius:12px;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;font-weight:700;transition:.2s}
.btn:hover{border-color:var(--green);transform:translateY(-1px)}
.btn-primary{background:var(--green);color:#000;border-color:var(--green)}
.big{width:100%;margin-top:18px;padding:16px;font-size:17px}

.hero{padding:80px 24px;text-align:center;max-width:1100px;margin:0 auto}
.hero h1{font-size:48px;line-height:1.1;font-weight:900}
.hero h1 span{color:var(--green);text-shadow:0 0 30px rgba(34,255,102,.4)}
.hero p{color:var(--muted);margin:16px auto;font-size:18px}
.truth{max-width:700px;margin:24px auto;background:#1a2a1a;border:1px solid #2a4a2a;border-radius:14px;padding:14px;color:#c2e2c2}

.container{max-width:1200px;margin:0 auto;padding:0 24px 80px;display:grid;grid-template-columns:320px 1fr;gap:20px}
.sidebar{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:18px;position:sticky;top:80px;height:fit-content}
.sidebar h3{font-size:13px;color:var(--muted);margin:18px 0 10px}
.model{padding:12px;border:1px solid var(--border);border-radius:12px;margin-bottom:8px;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.model.active{border-color:var(--green);background:rgba(34,255,102,.08)}
.model small{color:var(--muted);font-size:11px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green)}

.main{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:22px}
.tabs{display:flex;gap:8px;margin-bottom:20px;background:#0d130d;padding:6px;border-radius:12px;width:fit-content}
.tab{padding:8px 16px;border-radius:8px;cursor:pointer;color:var(--muted);font-weight:700}
.tab.active{background:var(--green);color:#000}
label{display:block;margin:14px 0 6px;color:var(--muted);font-size:13px;font-weight:700}
textarea,input,select{width:100%;background:#0a120a;border:1px solid var(--border);border-radius:12px;padding:14px;color:var(--text);outline:none}
textarea:focus,input:focus{border-color:var(--green)}
textarea{height:110px;resize:none}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}

.progress{display:none;margin-top:18px;background:#0a120a;border:1px solid var(--border);border-radius:12px;padding:14px}
.progress.top{display:flex;justify-content:space-between}
.bar{height:8px;background:#0f1f0f;border-radius:20px;overflow:hidden;margin-top:10px}
.bar i{display:block;height:100%;width:0%;background:var(--green);transition:width.3s}
.logs{font-size:11px;color:var(--muted);margin-top:8px}
.result{display:none;margin-top:20px}
video{width:100%;border-radius:16px;background:#000}

.timeline{border:1px dashed var(--border);border-radius:12px;padding:14px;min-height:120px}
.scene{background:#0f1a0f;border:1px solid var(--border);padding:10px;border-radius:10px;margin-bottom:8px;display:flex;justify-content:space-between}

.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;z-index:200}
.box{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:24px;width:90%;max-width:460px}
.box p{color:var(--muted);font-size:13px;margin:8px 0}
.ok{color:var(--green);font-size:11px;margin-top:10px}

@media(max-width:900px){.container{grid-template-columns:1fr}.hero h1{font-size:32px}.row{grid-template-columns:1fr}}